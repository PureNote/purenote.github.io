---
import {
  languages,
  useTranslations,
  getLocalizedPath,
  localizedFaqs,
  localizedHowTo,
  type Locale,
} from '../i18n/ui';

interface Props {
  lang: Locale;
  canonicalUrl: string;
  description: string;
}

const { lang, canonicalUrl, description } = Astro.props;
const t = useTranslations(lang);
const siteOrigin = 'https://purenote.github.io';
const faqs = localizedFaqs[lang] || localizedFaqs.en;
const howToSteps = localizedHowTo[lang] || localizedHowTo.en;
const homeUrl = new URL(getLocalizedPath(lang, ''), siteOrigin).toString();

// Strictly ZERO fake AggregateRating or Review schemas
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'PureNote',
      alternateName: t('hero.h1'),
      url: canonicalUrl,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'All',
      inLanguage: languages[lang].hreflang,
      isAccessibleForFree: true,
      browserRequirements: 'Requires HTML5 and localStorage support',
      description,
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
      },
      featureList: [
        'Instant Multi-Tab Text & Memo Editor with 0ms localStorage Auto-Save',
        'Live Word Counter, Character Counter, Line Counter & Reading Time',
        '1-Click Export to .TXT, .HTML, .MD, and Print-ready Notepad to PDF',
        'Quick Sketch / Notepad Online Draw HTML5 Canvas',
        'Zero-Server #note URL Hash Link Sharing',
      ],
    },
    {
      '@type': 'HowTo',
      name: t('howto.title'),
      description: t('howto.subtitle'),
      totalTime: 'PT1M',
      step: howToSteps.map((stepItem, index) => ({
        '@type': 'HowToStep',
        position: index + 1,
        name: stepItem.name,
        text: stepItem.text,
        url: `${canonicalUrl}#step-${index + 1}`,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('breadcrumb.home'),
          item: siteOrigin + '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t('breadcrumb.tools'),
          item: `${homeUrl}#productivity-tools`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: t('breadcrumb.notepad'),
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
