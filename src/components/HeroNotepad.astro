---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  aria-label={t('hero.h1')}
  class="mx-auto flex min-h-[calc(100dvh-4rem)] w-full max-w-7xl flex-col justify-between px-2.5 py-2 sm:px-6 sm:py-3 lg:px-8"
>
  <!-- Compact First-Fold Header Bar: H1 + Creative Tools & Modes Collapse Toggle Button -->
  <div class="mb-2 flex flex-wrap items-center justify-between gap-2 px-1 no-print">
    <div class="flex items-center gap-2.5">
      <span
        class="hidden sm:inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[#B9E4E8] dark:bg-[#167D8D] text-[#071B2B] dark:text-[#FFFFFF] border-2 border-[#167D8D] shadow-sm"
        aria-hidden="true"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
      </span>
      <h1 class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight text-[#071B2B] dark:text-[#EEEEEE] leading-tight">
        {t('hero.h1')}
      </h1>
    </div>

    <!-- Creative Expand / Collapse Tools & Modes Arrow Button -->
    <button
      type="button"
      id="btn-toggle-workspace-tools"
      aria-expanded="false"
      aria-controls="workspace-collapsible-tray"
      data-label-show={t('toolbar.toggleTools')}
      data-label-hide={t('toolbar.hideTools')}
      class="group inline-flex items-center gap-2.5 rounded-2xl border-2 border-[#167D8D] bg-[#FFFFFF] dark:bg-[#0C293F] px-3.5 py-2 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] shadow-sm hover:bg-[#167D8D] hover:text-[#FFFFFF] dark:hover:bg-[#167D8D] transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#167D8D]"
    >
      <svg class="h-4 w-4 sm:h-5 sm:w-5 text-[#167D8D] dark:text-[#B9E4E8] group-hover:text-[#FFFFFF] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="21" x2="4" y2="14"></line>
        <line x1="4" y1="10" x2="4" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12" y2="3"></line>
        <line x1="20" y1="21" x2="20" y2="16"></line>
        <line x1="20" y1="12" x2="20" y2="3"></line>
        <line x1="1" y1="14" x2="7" y2="14"></line>
        <line x1="9" y1="8" x2="15" y2="8"></line>
        <line x1="17" y1="16" x2="23" y2="16"></line>
      </svg>
      <span id="workspace-tools-toggle-label">{t('toolbar.toggleTools')}</span>
      <span
        id="workspace-tools-chevron-wrap"
        class="flex h-6 w-6 items-center justify-center rounded-full bg-[#B9E4E8] dark:bg-[#167D8D] text-[#071B2B] dark:text-[#FFFFFF] group-hover:bg-[#071B2B] group-hover:text-[#B9E4E8] transition-all duration-200"
      >
        <svg
          id="workspace-tools-chevron"
          class="h-4 w-4 transition-transform duration-300"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </button>
  </div>

  <!-- INTERACTIVE NOTEPAD BOX DIV (Main First-Fold Workspace) -->
  <div
    id="purenote-workspace-box"
    data-default-tab-prefix={t('toolbar.defaultTabPrefix')}
    data-copied-text={t('toolbar.copied')}
    data-share-copied-text={t('toolbar.shareCopied')}
    data-shared-loaded-text={t('editor.sharedNoteLoaded')}
    data-clear-confirm={t('toolbar.clearConfirm')}
    data-min-read={t('metrics.minRead')}
    data-sec-read={t('metrics.secRead')}
    data-empty-preview={t('editor.emptyNotePreview')}
    data-duplicate-label={t('editor.duplicateNote')}
    class="flex flex-1 flex-col rounded-3xl border-2 border-[#167D8D] bg-[#FFFFFF] dark:bg-[#0F324D] p-2.5 sm:p-4 shadow-workspace dark:shadow-workspace-dark transition-colors duration-200"
  >
    <!-- COLLAPSIBLE FEATURES TRAY (Hidden on initial load for super-minimal Notepad view; expands smoothly on click) -->
    <div id="workspace-collapsible-tray" class="hidden flex-col mb-3 animate-panel-enter no-print">
      <!-- MODE SELECTOR PILLS -->
      <div
        role="tablist"
        aria-label="Notepad Workspace Modes"
        class="mb-2.5 flex items-center gap-1.5 sm:gap-2 overflow-x-auto pb-1"
      >
        <!-- 1. Writing Notepad (Default) -->
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-mode-btn="writing"
          class="mode-pill-btn active-mode-pill group flex shrink-0 items-center gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#167D8D] px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-extrabold text-[#FFFFFF] shadow-sm transition-all duration-150"
        >
          <svg class="h-5 w-5 sm:h-6 sm:w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          <span>{t('mode.writing')}</span>
        </button>

        <!-- 2. Multi-Note Tabs -->
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-mode-btn="multitab"
          class="mode-pill-btn group flex shrink-0 items-center gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#B9E4E8]/60 dark:bg-[#0C293F] px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#167D8D] hover:text-[#FFFFFF] transition-all duration-150"
        >
          <svg class="h-5 w-5 sm:h-6 sm:w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
          </svg>
          <span>{t('mode.multiTab')}</span>
          <span
            id="mode-tab-count-badge"
            class="ml-0.5 rounded-full bg-[#071B2B] text-[#B9E4E8] px-2 py-0.5 text-[11px] font-black"
          >
            1
          </span>
        </button>

        <!-- 3. Notepad to PDF -->
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-mode-btn="pdf"
          class="mode-pill-btn group flex shrink-0 items-center gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#B9E4E8]/60 dark:bg-[#0C293F] px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#167D8D] hover:text-[#FFFFFF] transition-all duration-150"
        >
          <svg class="h-5 w-5 sm:h-6 sm:w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <path d="M9 15h6"></path>
            <path d="M12 12v6"></path>
          </svg>
          <span>{t('mode.pdf')}</span>
        </button>

        <!-- 4. Word Counter & Tools -->
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-mode-btn="tools"
          class="mode-pill-btn group flex shrink-0 items-center gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#B9E4E8]/60 dark:bg-[#0C293F] px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#167D8D] hover:text-[#FFFFFF] transition-all duration-150"
        >
          <svg class="h-5 w-5 sm:h-6 sm:w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 7 4 4 20 4 20 7"></polyline>
            <line x1="9" y1="20" x2="15" y2="20"></line>
            <line x1="12" y1="4" x2="12" y2="20"></line>
          </svg>
          <span>{t('mode.wordCounter')}</span>
        </button>

        <!-- 5. Draw / Sketch Pad -->
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-mode-btn="draw"
          class="mode-pill-btn group flex shrink-0 items-center gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#B9E4E8]/60 dark:bg-[#0C293F] px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#167D8D] hover:text-[#FFFFFF] transition-all duration-150"
        >
          <svg class="h-5 w-5 sm:h-6 sm:w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
            <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
            <path d="M2 2l7.586 7.586"></path>
            <circle cx="11" cy="11" r="2"></circle>
          </svg>
          <span>{t('mode.draw')}</span>
        </button>
      </div>

      <!-- STEP 1: TOP ACTION BAR + INSTANT MULTI-TAB BAR -->
      <div class="flex flex-col gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#EEEEEE] dark:bg-[#0C293F] p-2 sm:p-2.5">
        <!-- Row A: Multi-Note Tab Strip + Note Title Input -->
        <div class="flex flex-wrap items-center justify-between gap-2">
          <!-- Dynamic Tabs Container -->
          <div
            id="note-tabs-strip"
            class="flex flex-1 items-center gap-1.5 overflow-x-auto pb-0.5"
            role="tablist"
            aria-label="Saved Browser Notes"
          >
            <!-- Populated dynamically by instant localStorage engine -->
          </div>

          <!-- + New Note Tab Button -->
          <button
            type="button"
            id="btn-new-tab"
            aria-label={t('toolbar.newTab')}
            class="flex shrink-0 items-center gap-1.5 rounded-xl border-2 border-[#167D8D] bg-[#167D8D] px-3.5 py-1.5 text-xs sm:text-sm font-extrabold text-[#FFFFFF] shadow-sm hover:bg-[#071B2B] dark:hover:bg-[#B9E4E8] dark:hover:text-[#071B2B] transition-all"
          >
            <span>{t('toolbar.newTab')}</span>
          </button>
        </div>

        <!-- Row B: Active Note Title + Oversized Action Toolbar (Font Size +/-, Copy All, Clear, Share Link, Open File) -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-[#167D8D]/30 pt-2">
          <!-- Editable Note Title -->
          <div class="flex min-w-[180px] flex-1 items-center gap-2">
            <svg class="h-5 w-5 shrink-0 text-[#167D8D] dark:text-[#B9E4E8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <input
              type="text"
              id="active-note-title"
              placeholder={t('toolbar.noteTitlePlaceholder')}
              aria-label={t('toolbar.noteTitlePlaceholder')}
              class="w-full max-w-xs rounded-xl border-2 border-[#167D8D]/60 bg-[#FFFFFF] dark:bg-[#071B2B] px-3 py-1.5 text-sm sm:text-base font-extrabold text-[#071B2B] dark:text-[#EEEEEE] placeholder-[#167D8D]/70 focus:border-[#167D8D] focus:outline-none"
            />
          </div>

          <!-- Action Buttons Group -->
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <!-- Font Size (- / +) Toggle (18px - 24px) -->
            <div class="flex items-center rounded-xl border-2 border-[#167D8D] bg-[#FFFFFF] dark:bg-[#071B2B] p-0.5">
              <button
                type="button"
                id="btn-font-decrease"
                aria-label={t('toolbar.fontDecrease')}
                title={t('toolbar.fontDecrease')}
                class="flex h-9 w-9 items-center justify-center rounded-lg font-black text-sm text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#B9E4E8] dark:hover:bg-[#167D8D] transition-colors"
              >
                A-
              </button>
              <span
                id="font-size-indicator"
                class="px-2 text-xs font-extrabold text-[#167D8D] dark:text-[#B9E4E8]"
              >
                20px
              </span>
              <button
                type="button"
                id="btn-font-increase"
                aria-label={t('toolbar.fontIncrease')}
                title={t('toolbar.fontIncrease')}
                class="flex h-9 w-9 items-center justify-center rounded-lg font-black text-base text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#B9E4E8] dark:hover:bg-[#167D8D] transition-colors"
              >
                A+
              </button>
            </div>

            <!-- Open Local .TXT/.MD File -->
            <label
              for="import-file-input"
              class="cursor-pointer flex h-10 items-center gap-1.5 rounded-xl border-2 border-[#167D8D] bg-[#B9E4E8]/60 dark:bg-[#071B2B] px-3 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#167D8D] hover:text-[#FFFFFF] transition-colors"
            >
              <svg class="h-4 w-4 sm:h-5 sm:w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span class="hidden sm:inline">{t('toolbar.importTxt')}</span>
              <input id="import-file-input" type="file" accept=".txt,.md,.html,.csv,.json,.log" class="hidden" />
            </label>

            <!-- Copy All (Online Clipboard) -->
            <button
              type="button"
              id="btn-copy-all"
              aria-label={t('toolbar.copyAllAria')}
              class="flex h-10 items-center gap-1.5 rounded-xl border-2 border-[#167D8D] bg-[#167D8D] px-3.5 text-xs sm:text-sm font-extrabold text-[#FFFFFF] hover:bg-[#071B2B] dark:hover:bg-[#B9E4E8] dark:hover:text-[#071B2B] transition-all"
            >
              <svg class="h-4 w-4 sm:h-5 sm:w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-all-label">{t('toolbar.copyAll')}</span>
            </button>

            <!-- Share Link (#note=...) -->
            <button
              type="button"
              id="btn-share-link"
              aria-label={t('toolbar.shareLink')}
              class="flex h-10 items-center gap-1.5 rounded-xl border-2 border-[#167D8D] bg-[#B9E4E8] dark:bg-[#167D8D] px-3.5 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#FFFFFF] hover:bg-[#071B2B] hover:text-[#FFFFFF] dark:hover:bg-[#B9E4E8] dark:hover:text-[#071B2B] transition-all"
            >
              <svg class="h-4 w-4 sm:h-5 sm:w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span id="share-link-label">{t('toolbar.shareLink')}</span>
            </button>

            <!-- Clear Note -->
            <button
              type="button"
              id="btn-clear-note"
              aria-label={t('toolbar.clear')}
              class="flex h-10 items-center gap-1.5 rounded-xl border-2 border-[#167D8D] bg-[#FFFFFF] dark:bg-[#071B2B] px-3 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#071B2B] hover:text-[#FFFFFF] dark:hover:bg-[#167D8D] transition-all"
            >
              <svg class="h-4 w-4 sm:h-5 sm:w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              <span class="hidden sm:inline">{t('toolbar.clear')}</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- STEP 2: MAIN EDITOR CANVAS & SPECIALIZED MODE PANELS -->
    <div class="relative flex flex-1 flex-col min-h-[340px] sm:min-h-[420px]">
      <!-- PANEL 1: WRITING NOTEPAD (Default Oversized Distraction-Free Textarea) -->
      <div id="mode-panel-writing" class="flex flex-1 flex-col animate-panel-enter">
        <textarea
          id="purenote-textarea"
          placeholder={t('editor.placeholder')}
          aria-label={t('hero.h1')}
          spellcheck="true"
          style="font-size: 20px; line-height: 1.65;"
          class="purenote-editor-textarea w-full flex-1 resize-none rounded-2xl bg-[#FFFFFF] dark:bg-[#071B2B] p-4 sm:p-6 font-sans text-[#071B2B] dark:text-[#EEEEEE] placeholder-[#167D8D]/70 dark:placeholder-[#B9E4E8]/60 shadow-inner"
        ></textarea>
      </div>

      <!-- PANEL 2: MULTI-NOTE TABS MANAGER -->
      <div id="mode-panel-multitab" class="hidden flex-1 flex-col rounded-2xl border-2 border-[#167D8D] bg-[#EEEEEE]/70 dark:bg-[#071B2B] p-4 sm:p-6 animate-panel-enter">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-[#071B2B] dark:text-[#EEEEEE]">
              {t('mode.multiTab')}
            </h2>
            <p class="text-sm font-medium text-[#167D8D] dark:text-[#B9E4E8]">
              {t('editor.tabManagerHint')}
            </p>
          </div>
          <button
            type="button"
            id="btn-multitab-create"
            class="flex items-center gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#167D8D] px-4 py-2.5 text-sm font-extrabold text-[#FFFFFF] hover:bg-[#071B2B] dark:hover:bg-[#B9E4E8] dark:hover:text-[#071B2B] transition-all"
          >
            <span>{t('editor.createNewNoteCard')}</span>
          </button>
        </div>
        <div id="multitab-cards-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 overflow-y-auto max-h-[380px] pr-1">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- PANEL 3: NOTEPAD TO PDF STUDIO -->
      <div id="mode-panel-pdf" class="hidden flex-1 flex-col rounded-2xl border-2 border-[#167D8D] bg-[#EEEEEE]/70 dark:bg-[#071B2B] p-4 sm:p-6 animate-panel-enter">
        <div class="mb-4">
          <h2 class="text-xl sm:text-2xl font-black text-[#071B2B] dark:text-[#EEEEEE]">
            {t('pdf.title')}
          </h2>
          <p class="text-sm font-medium text-[#167D8D] dark:text-[#B9E4E8]">
            {t('pdf.subtitle')}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="flex flex-col gap-3 rounded-2xl border-2 border-[#167D8D] bg-[#FFFFFF] dark:bg-[#0C293F] p-4">
            <div>
              <label for="pdf-doc-title" class="block text-xs font-extrabold uppercase tracking-wider text-[#167D8D] dark:text-[#B9E4E8] mb-1">
                {t('pdf.docTitleLabel')}
              </label>
              <input
                type="text"
                id="pdf-doc-title"
                placeholder={t('toolbar.noteTitlePlaceholder')}
                class="w-full rounded-xl border-2 border-[#167D8D] bg-[#EEEEEE]/60 dark:bg-[#071B2B] px-3.5 py-2 text-base font-bold text-[#071B2B] dark:text-[#EEEEEE] focus:outline-none"
              />
            </div>

            <div>
              <label for="pdf-font-family" class="block text-xs font-extrabold uppercase tracking-wider text-[#167D8D] dark:text-[#B9E4E8] mb-1">
                {t('pdf.fontFamilyLabel')}
              </label>
              <select
                id="pdf-font-family"
                class="w-full rounded-xl border-2 border-[#167D8D] bg-[#EEEEEE]/60 dark:bg-[#071B2B] px-3.5 py-2 text-base font-bold text-[#071B2B] dark:text-[#EEEEEE] focus:outline-none"
              >
                <option value="sans">{t('pdf.fontSans')}</option>
                <option value="serif">{t('pdf.fontSerif')}</option>
                <option value="mono">{t('pdf.fontMono')}</option>
              </select>
            </div>
          </div>

