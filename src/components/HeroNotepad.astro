<script is:inline>
  (function () {
    const STORAGE_KEY_TABS = 'purenote_tabs_v1';
    const STORAGE_KEY_ACTIVE = 'purenote_active_tab_v1';
    const STORAGE_KEY_FONT = 'purenote_font_size_v1';
    const STORAGE_KEY_CANVAS = 'purenote_canvas_v1';

    const workspaceBox = document.getElementById('purenote-workspace-box');
    if (!workspaceBox) return;

    const defaultTabPrefix = workspaceBox.getAttribute('data-default-tab-prefix') || 'Note';
    const copiedText = workspaceBox.getAttribute('data-copied-text') || '✓ Copied!';
    const shareCopiedText = workspaceBox.getAttribute('data-share-copied-text') || '✓ Share Link Copied!';
    const sharedLoadedText = workspaceBox.getAttribute('data-shared-loaded-text') || '✓ Loaded shared note!';
    const clearConfirmText = workspaceBox.getAttribute('data-clear-confirm') || 'Clear current note?';
    const minReadLabel = workspaceBox.getAttribute('data-min-read') || 'min read';
    const secReadLabel = workspaceBox.getAttribute('data-sec-read') || 'sec read';
    const emptyPreviewLabel = workspaceBox.getAttribute('data-empty-preview') || '(Empty note)';
    const duplicateLabel = workspaceBox.getAttribute('data-duplicate-label') || 'Duplicate';

    const textarea = document.getElementById('purenote-textarea');
    const titleInput = document.getElementById('active-note-title');
    const pdfTitleInput = document.getElementById('pdf-doc-title');
    const tabsStrip = document.getElementById('note-tabs-strip');
    const tabCountBadge = document.getElementById('mode-tab-count-badge');
    const multiTabGrid = document.getElementById('multitab-cards-grid');

    const metricWords = document.getElementById('metric-words');
    const metricChars = document.getElementById('metric-chars');
    const metricLines = document.getElementById('metric-lines');
    const metricReading = document.getElementById('metric-reading-time');
    const keywordList = document.getElementById('keyword-density-list');

    const toastEl = document.getElementById('purenote-toast');
    let toastTimeout = null;

    function showToast(msg) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.remove('hidden');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toastEl.classList.add('hidden');
      }, 3200);
    }

    window.addEventListener('purenote:toast', (e) => {
      if (e.detail && e.detail.message) showToast(e.detail.message);
    });

    // UTF-8 safe Base64 URL encoding/decoding for #note=... zero-server sharing
    function encodeNoteToHash(obj) {
      try {
        const json = JSON.stringify(obj);
        const bytes = new TextEncoder().encode(json);
        let binary = '';
        for (let i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }
        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      } catch (e) {
        return '';
      }
    }

    function decodeNoteFromHash(encoded) {
      try {
        let base64 = encoded.replace(/-/g, '+').replace(/_/g, '/');
        while (base64.length % 4) base64 += '=';
        const binary = atob(base64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
          bytes[i] = binary.charCodeAt(i);
        }
        const json = new TextDecoder().decode(bytes);
        return JSON.parse(json);
      } catch (e) {
        return null;
      }
    }

    // State initialization
    let tabs = [];
    let activeTabId = '';
    let fontSize = 20;

    function createDefaultTab(index) {
      return {
        id: 'note_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
        title: defaultTabPrefix + ' ' + index,
        content: '',
        updatedAt: Date.now(),
      };
    }

    function loadFromStorage() {
      try {
        const rawTabs = localStorage.getItem(STORAGE_KEY_TABS);
        if (rawTabs) {
          const parsed = JSON.parse(rawTabs);
          if (Array.isArray(parsed) && parsed.length > 0) {
            tabs = parsed;
          }
        }
        const savedActive = localStorage.getItem(STORAGE_KEY_ACTIVE);
        if (savedActive && tabs.some((t) => t.id === savedActive)) {
          activeTabId = savedActive;
        }
        const savedFont = Number(localStorage.getItem(STORAGE_KEY_FONT));
        if (savedFont >= 16 && savedFont <= 28) {
          fontSize = savedFont;
        }
      } catch (e) {}

      if (tabs.length === 0) {
        const first = createDefaultTab(1);
        tabs = [first];
        activeTabId = first.id;
      } else if (!activeTabId) {
        activeTabId = tabs[0].id;
      }

      // Check URL hash #note=...
      if (window.location.hash && window.location.hash.startsWith('#note=')) {
        const encoded = window.location.hash.slice(6);
        const shared = decodeNoteFromHash(encoded);
        if (shared && typeof shared.c === 'string') {
          const sharedTab = {
            id: 'note_shared_' + Date.now(),
            title: shared.t || defaultTabPrefix + ' (Shared)',
            content: shared.c,
            updatedAt: Date.now(),
          };
          tabs.unshift(sharedTab);
          activeTabId = sharedTab.id;
          saveToStorage();
          setTimeout(() => showToast(sharedLoadedText), 250);
        }
      }
    }

    function saveToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY_TABS, JSON.stringify(tabs));
        localStorage.setItem(STORAGE_KEY_ACTIVE, activeTabId);
      } catch (e) {}
    }

    function getActiveTab() {
      return tabs.find((t) => t.id === activeTabId) || tabs[0];
    }

    // Live Metrics Computation
    function updateMetrics(text) {
      const trimmed = text.trim();
      const wordsArray = trimmed ? trimmed.split(/\s+/).filter(Boolean) : [];
      const wordCount = wordsArray.length;
      const charCount = text.length;
      const lineCount = text.length === 0 ? 1 : text.split(/\r\n|\r|\n/).length;

      if (metricWords) metricWords.textContent = wordCount.toLocaleString();
      if (metricChars) metricChars.textContent = charCount.toLocaleString();
      if (metricLines) metricLines.textContent = lineCount.toLocaleString();

      let shortReadingText = '0s';
      if (wordCount > 0) {
        const totalSeconds = Math.ceil((wordCount / 200) * 60);
        if (totalSeconds < 60) {
          shortReadingText = totalSeconds + 's';
        } else {
          const mins = Math.ceil(wordCount / 200);
          shortReadingText = mins + 'm';
        }
      }

      if (metricReading) metricReading.textContent = shortReadingText;

      // Update keyword frequency in Word Counter & Tools panel
      if (keywordList && wordsArray.length > 0) {
        const freq = {};
        wordsArray.forEach((w) => {
          const clean = w.toLowerCase().replace(/[^\p{L}\p{N}_-]+/gu, '');
          if (clean.length >= 3) {
            freq[clean] = (freq[clean] || 0) + 1;
          }
        });
        const top = Object.entries(freq)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 8);
        if (top.length > 0) {
          keywordList.innerHTML = top
            .map(
              ([word, count]) =>
                `<span class="inline-flex items-center gap-1.5 rounded-xl border border-[#167D8D] bg-[#B9E4E8]/50 dark:bg-[#071B2B] px-3 py-1 text-xs font-extrabold"><span>${word}</span><span class="rounded-md bg-[#167D8D] px-1.5 py-0.5 text-[11px] text-[#FFFFFF]">${count}×</span></span>`
            )
            .join('');
        }
      }
    }

    // Render Multi-Tab Strip & Multi-Tab Grid
    function renderTabs() {
      const current = getActiveTab();
      if (tabCountBadge) tabCountBadge.textContent = String(tabs.length);

      if (tabsStrip) {
        tabsStrip.innerHTML = '';
        tabs.forEach((tab) => {
          const isAct = tab.id === current.id;
          const btn = document.createElement('div');
          btn.setAttribute('role', 'tab');
          btn.setAttribute('aria-selected', String(isAct));
          btn.className = isAct
            ? 'flex shrink-0 items-center gap-2 rounded-xl border-2 border-[#071B2B] dark:border-[#B9E4E8] bg-[#071B2B] dark:bg-[#167D8D] px-3 py-1.5 text-xs sm:text-sm font-extrabold text-[#FFFFFF] cursor-pointer shadow-sm transition-all'
            : 'flex shrink-0 items-center gap-2 rounded-xl border-2 border-[#167D8D]/60 bg-[#FFFFFF] dark:bg-[#071B2B] px-3 py-1.5 text-xs sm:text-sm font-bold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#B9E4E8] dark:hover:bg-[#167D8D]/50 cursor-pointer transition-all';

          const titleSpan = document.createElement('span');
          titleSpan.className = 'max-w-[130px] truncate';
          titleSpan.textContent = tab.title || defaultTabPrefix;
          btn.appendChild(titleSpan);

          if (tabs.length > 1) {
            const closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.className = 'ml-1 rounded-md px-1 hover:bg-[#167D8D] hover:text-[#FFFFFF] text-xs font-black';
            closeBtn.textContent = '×';
            closeBtn.setAttribute('aria-label', 'Close ' + tab.title);
            closeBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              deleteTab(tab.id);
            });
            btn.appendChild(closeBtn);
          }

          btn.addEventListener('click', () => {
            switchTab(tab.id);
          });

          tabsStrip.appendChild(btn);
        });
      }

      if (multiTabGrid) {
        multiTabGrid.innerHTML = '';
        tabs.forEach((tab) => {
          const isAct = tab.id === current.id;
          const card = document.createElement('div');
          card.className = isAct
            ? 'flex flex-col justify-between rounded-2xl border-2 border-[#071B2B] dark:border-[#B9E4E8] bg-[#B9E4E8]/70 dark:bg-[#167D8D]/40 p-4 shadow-md'
            : 'flex flex-col justify-between rounded-2xl border-2 border-[#167D8D] bg-[#FFFFFF] dark:bg-[#0C293F] p-4 hover:border-[#071B2B] transition-all';

          const words = tab.content.trim() ? tab.content.trim().split(/\s+/).filter(Boolean).length : 0;
          const preview = tab.content.trim() ? tab.content.trim().slice(0, 100) : emptyPreviewLabel;

          card.innerHTML = `
            <div class="cursor-pointer" data-card-select="${tab.id}">
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <h3 class="font-black text-base text-[#071B2B] dark:text-[#EEEEEE] truncate">${ (tab.title || defaultTabPrefix).replace(/</g, '&lt;') }</h3>
                <span class="rounded-lg bg-[#167D8D] px-2 py-0.5 text-xs font-extrabold text-[#FFFFFF]">${words} w</span>
              </div>
              <p class="text-xs font-medium text-[#071B2B]/80 dark:text-[#EEEEEE]/80 line-clamp-2 mb-3">${preview.replace(/</g, '&lt;')}</p>
            </div>
            <div class="flex items-center justify-between gap-2 border-t border-[#167D8D]/30 pt-2">
              <button type="button" data-card-dup="${tab.id}" class="rounded-lg border border-[#167D8D] bg-[#FFFFFF] dark:bg-[#071B2B] px-2.5 py-1 text-xs font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#167D8D] hover:text-[#FFFFFF] transition-colors">${duplicateLabel}</button>
              ${tabs.length > 1 ? `<button type="button" data-card-del="${tab.id}" class="rounded-lg border border-[#167D8D] bg-[#FFFFFF] dark:bg-[#071B2B] px-2.5 py-1 text-xs font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#071B2B] hover:text-[#FFFFFF] transition-colors">×</button>` : ''}
            </div>
          `;

          card.querySelector(`[data-card-select="${tab.id}"]`)?.addEventListener('click', () => {
            switchTab(tab.id);
            activateMode('writing');
          });

          card.querySelector(`[data-card-dup="${tab.id}"]`)?.addEventListener('click', () => {
            const copy = {
              id: 'note_' + Date.now(),
              title: tab.title + ' (Copy)',
              content: tab.content,
              updatedAt: Date.now(),
            };
            tabs.push(copy);
            activeTabId = copy.id;
            saveToStorage();
            syncEditorWithActiveTab();
          });

          card.querySelector(`[data-card-del="${tab.id}"]`)?.addEventListener('click', () => {
            deleteTab(tab.id);
          });

          multiTabGrid.appendChild(card);
        });
      }
    }

    function syncEditorWithActiveTab() {
      const current = getActiveTab();
      if (!current) return;
      if (textarea) textarea.value = current.content;
      if (titleInput) titleInput.value = current.title;
      if (pdfTitleInput) pdfTitleInput.value = current.title;
      updateMetrics(current.content);
      renderTabs();
    }

    function switchTab(id) {
      activeTabId = id;
      saveToStorage();
      syncEditorWithActiveTab();
    }

    function createNewTab() {
      const nextNum = tabs.length + 1;
      const newTab = createDefaultTab(nextNum);
      tabs.push(newTab);
      activeTabId = newTab.id;
      saveToStorage();
      syncEditorWithActiveTab();
      activateMode('writing');
      if (textarea) textarea.focus();
    }

    function deleteTab(id) {
      if (tabs.length <= 1) return;
      const idx = tabs.findIndex((t) => t.id === id);
      if (idx === -1) return;
      tabs.splice(idx, 1);
      if (activeTabId === id) {
        const nextTab = tabs[Math.max(0, idx - 1)];
        activeTabId = nextTab.id;
      }
      saveToStorage();
      syncEditorWithActiveTab();
    }

    // Font Size Control (18px - 24px)
    const fontIndicator = document.getElementById('font-size-indicator');
    function applyFontSize() {
      if (textarea) textarea.style.fontSize = fontSize + 'px';
      if (fontIndicator) fontIndicator.textContent = fontSize + 'px';
      try {
        localStorage.setItem(STORAGE_KEY_FONT, String(fontSize));
      } catch (e) {}
    }

    document.getElementById('btn-font-decrease')?.addEventListener('click', () => {
      fontSize = Math.max(16, fontSize - 2);
      applyFontSize();
    });

    document.getElementById('btn-font-increase')?.addEventListener('click', () => {
      fontSize = Math.min(28, fontSize + 2);
      applyFontSize();
    });

    // Real-Time 0ms Auto-Save on Every Keystroke
    textarea?.addEventListener('input', () => {
      const current = getActiveTab();
      if (!current) return;
      current.content = textarea.value;
      current.updatedAt = Date.now();
      saveToStorage();
      updateMetrics(current.content);
    });

    titleInput?.addEventListener('input', () => {
      const current = getActiveTab();
      if (!current) return;
      current.title = titleInput.value || defaultTabPrefix;
      current.updatedAt = Date.now();
      if (pdfTitleInput) pdfTitleInput.value = current.title;
      saveToStorage();
      renderTabs();
    });

    document.getElementById('btn-new-tab')?.addEventListener('click', createNewTab);
    document.getElementById('btn-multitab-create')?.addEventListener('click', createNewTab);

    // Copy All (Online Clipboard)
    document.getElementById('btn-copy-all')?.addEventListener('click', async () => {
      const text = textarea ? textarea.value : '';
      try {
        await navigator.clipboard.writeText(text);
        showToast(copiedText);
      } catch (e) {
        if (textarea) {
          textarea.select();
          document.execCommand('copy');
          showToast(copiedText);
        }
      }
    });

    // Clear Note
    document.getElementById('btn-clear-note')?.addEventListener('click', () => {
      if (!textarea || !textarea.value) return;
      if (window.confirm(clearConfirmText)) {
        textarea.value = '';
        const current = getActiveTab();
        if (current) {
          current.content = '';
          current.updatedAt = Date.now();
          saveToStorage();
        }
        updateMetrics('');
        renderTabs();
        textarea.focus();
      }
    });

    // Share Link (#note=...)
    document.getElementById('btn-share-link')?.addEventListener('click', async () => {
      const current = getActiveTab();
      if (!current) return;
      const hash = encodeNoteToHash({ t: current.title, c: current.content });
      const url = window.location.origin + window.location.pathname + '#note=' + hash;
      window.history.replaceState(null, '', '#note=' + hash);
      try {
        await navigator.clipboard.writeText(url);
        showToast(shareCopiedText);
      } catch (e) {
        showToast(shareCopiedText);
      }
    });

    // Open Local File (.TXT, .MD, .HTML)
    const importInput = document.getElementById('import-file-input');
    importInput?.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const content = typeof reader.result === 'string' ? reader.result : '';
        const current = getActiveTab();
        if (current) {
          current.title = file.name.replace(/\.[^/.]+$/, '');
          current.content = content;
          current.updatedAt = Date.now();
          saveToStorage();
          syncEditorWithActiveTab();
          activateMode('writing');
        }
      };
      reader.readAsText(file);
      importInput.value = '';
    });

    // Collapsible Workspace Tools & Modes Tray Toggle
    const toolsToggleBtn = document.getElementById('btn-toggle-workspace-tools');
    const toolsTray = document.getElementById('workspace-collapsible-tray');
    const toolsChevron = document.getElementById('workspace-tools-chevron');
    const toolsLabel = document.getElementById('workspace-tools-toggle-label');

    function setToolsTrayOpen(open) {
      if (!toolsTray || !toolsToggleBtn) return;
      const showLabel = toolsToggleBtn.getAttribute('data-label-show') || 'Tools & Modes';
      const hideLabel = toolsToggleBtn.getAttribute('data-label-hide') || 'Hide Tools';
      if (open) {
        toolsTray.classList.remove('hidden');
        toolsTray.classList.add('flex');
        toolsToggleBtn.setAttribute('aria-expanded', 'true');
        if (toolsChevron) toolsChevron.style.transform = 'rotate(180deg)';
        if (toolsLabel) toolsLabel.textContent = hideLabel;
      } else {
        toolsTray.classList.add('hidden');
        toolsTray.classList.remove('flex');
        toolsToggleBtn.setAttribute('aria-expanded', 'false');
        if (toolsChevron) toolsChevron.style.transform = 'rotate(0deg)';
        if (toolsLabel) toolsLabel.textContent = showLabel;
      }
    }

    toolsToggleBtn?.addEventListener('click', () => {
      if (!toolsTray) return;
      const isHidden = toolsTray.classList.contains('hidden');
      setToolsTrayOpen(isHidden);
    });

    // Mode Selector Pills Switching
    const modeButtons = document.querySelectorAll('[data-mode-btn]');
    const panels = {
      writing: document.getElementById('mode-panel-writing'),
      multitab: document.getElementById('mode-panel-multitab'),
      pdf: document.getElementById('mode-panel-pdf'),
      tools: document.getElementById('mode-panel-tools'),
      draw: document.getElementById('mode-panel-draw'),
    };

    function activateMode(modeKey) {
      if (modeKey !== 'writing') {
        setToolsTrayOpen(true);
      }
      modeButtons.forEach((btn) => {
        const key = btn.getAttribute('data-mode-btn');
        const isSelected = key === modeKey;
        btn.setAttribute('aria-selected', String(isSelected));
        if (isSelected) {
          btn.className =
            'mode-pill-btn active-mode-pill group flex shrink-0 items-center gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#167D8D] px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-extrabold text-[#FFFFFF] shadow-sm transition-all duration-150';
        } else {
          btn.className =
            'mode-pill-btn group flex shrink-0 items-center gap-2 rounded-2xl border-2 border-[#167D8D] bg-[#B9E4E8]/60 dark:bg-[#0C293F] px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] hover:bg-[#167D8D] hover:text-[#FFFFFF] transition-all duration-150';
        }
      });

      Object.entries(panels).forEach(([k, el]) => {
        if (!el) return;
        if (k === modeKey) {
          el.classList.remove('hidden');
          el.classList.add('flex');
        } else {
          el.classList.add('hidden');
          el.classList.remove('flex');
        }
      });

      if (modeKey === 'draw') {
        resizeCanvasIfNeeded();
      } else if (modeKey === 'multitab') {
        renderTabs();
      }
    }

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-mode-btn');
        if (key) activateMode(key);
      });
    });

    // Word Counter & Text Transformation Tools
    document.querySelectorAll('[data-transform]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!textarea) return;
        const type = btn.getAttribute('data-transform');
        let val = textarea.value;
        if (!val) return;

        switch (type) {
          case 'upper':
            val = val.toUpperCase();
            break;
          case 'lower':
            val = val.toLowerCase();
            break;
          case 'title':
            val = val.replace(/\w\S*/g, (w) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase());
            break;
          case 'sentence':
            val = val.toLowerCase().replace(/(^\s*\w|[.!?]\s+\w)/g, (c) => c.toUpperCase());
            break;
          case 'trim':
            val = val.replace(/[ \t]+/g, ' ').replace(/^ +| +$/gm, '');
            break;
          case 'blanklines':
            val = val
              .split(/\r?\n/)
              .filter((line) => line.trim().length > 0)
              .join('\n');
            break;
          case 'sortaz':
            val = val.split(/\r?\n/).sort((a, b) => a.localeCompare(b)).join('\n');
            break;
          case 'sortza':
            val = val.split(/\r?\n/).sort((a, b) => b.localeCompare(a)).join('\n');
            break;
          case 'dedupe':
            val = Array.from(new Set(val.split(/\r?\n/))).join('\n');
            break;
        }

        textarea.value = val;
        const current = getActiveTab();
        if (current) {
          current.content = val;
          current.updatedAt = Date.now();
          saveToStorage();
        }
        updateMetrics(val);
        showToast('✓ Text Updated!');
      });
    });

    // Find & Replace
    document.getElementById('btn-tool-replace-all')?.addEventListener('click', () => {
      const findEl = document.getElementById('tool-find-input');
      const repEl = document.getElementById('tool-replace-input');
      if (!findEl || !repEl || !textarea) return;
      const findStr = findEl.value;
      if (!findStr) return;
      const repStr = repEl.value || '';
      const updated = textarea.value.split(findStr).join(repStr);
      textarea.value = updated;
      const current = getActiveTab();
      if (current) {
        current.content = updated;
        current.updatedAt = Date.now();
        saveToStorage();
      }
      updateMetrics(updated);
      showToast('✓ Replaced All!');
    });

    // HTML5 Sketch / Draw Pad Engine
    const canvas = document.getElementById('purenote-draw-canvas');
    const ctx = canvas ? canvas.getContext('2d') : null;
    let isDrawing = false;
    let drawColor = '#071B2B';
    let drawSize = 4;
    let isEraser = false;
    const undoStack = [];

    function saveCanvasState() {
      if (!canvas) return;
      try {
        const dataUrl = canvas.toDataURL('image/png');
        undoStack.push(dataUrl);
        if (undoStack.length > 20) undoStack.shift();
        localStorage.setItem(STORAGE_KEY_CANVAS, dataUrl);
      } catch (e) {}
    }

    function resizeCanvasIfNeeded() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      if (canvas.width !== Math.floor(rect.width) || canvas.height !== Math.floor(rect.height)) {
        const savedData = localStorage.getItem(STORAGE_KEY_CANVAS);
        canvas.width = Math.floor(rect.width);
        canvas.height = Math.floor(rect.height);
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        if (savedData) {
          const img = new Image();
          img.onload = () => {
            ctx.drawImage(img, 0, 0);
          };
          img.src = savedData;
        }
      }
    }

    if (canvas && ctx) {
      const getPos = (e) => {
        const rect = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return {
          x: clientX - rect.left,
          y: clientY - rect.top,
        };
      };

      const startDraw = (e) => {
        isDrawing = true;
        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);
      };

      const moveDraw = (e) => {
        if (!isDrawing) return;
        if (e.cancelable) e.preventDefault();
        const pos = getPos(e);
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.lineWidth = isEraser ? drawSize * 3 : drawSize;
        ctx.strokeStyle = isEraser ? '#FFFFFF' : drawColor;
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
      };

      const endDraw = () => {
        if (!isDrawing) return;
        isDrawing = false;
        ctx.closePath();
        saveCanvasState();
      };

      canvas.addEventListener('mousedown', startDraw);
      canvas.addEventListener('mousemove', moveDraw);
      window.addEventListener('mouseup', endDraw);

      canvas.addEventListener('touchstart', startDraw, { passive: false });
      canvas.addEventListener('touchmove', moveDraw, { passive: false });
      window.addEventListener('touchend', endDraw);
    }

    const penBtn = document.getElementById('draw-tool-pen');
    const eraserBtn = document.getElementById('draw-tool-eraser');

    penBtn?.addEventListener('click', () => {
      isEraser = false;
      penBtn.className = 'rounded-xl border-2 border-[#167D8D] bg-[#167D8D] px-3 py-1.5 text-xs sm:text-sm font-extrabold text-[#FFFFFF] transition-colors';
      if (eraserBtn) eraserBtn.className = 'rounded-xl border-2 border-[#167D8D] bg-[#B9E4E8]/50 dark:bg-[#071B2B] px-3 py-1.5 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] transition-colors';
    });

    eraserBtn?.addEventListener('click', () => {
      isEraser = true;
      eraserBtn.className = 'rounded-xl border-2 border-[#167D8D] bg-[#167D8D] px-3 py-1.5 text-xs sm:text-sm font-extrabold text-[#FFFFFF] transition-colors';
      if (penBtn) penBtn.className = 'rounded-xl border-2 border-[#167D8D] bg-[#B9E4E8]/50 dark:bg-[#071B2B] px-3 py-1.5 text-xs sm:text-sm font-extrabold text-[#071B2B] dark:text-[#EEEEEE] transition-colors';
    });

    document.querySelectorAll('[data-draw-color]').forEach((swatch) => {
      swatch.addEventListener('click', () => {
        isEraser = false;
        drawColor = swatch.getAttribute('data-draw-color') || '#071B2B';
        document.querySelectorAll('[data-draw-color]').forEach((s) => s.classList.remove('ring-2', 'ring-[#167D8D]'));
        swatch.classList.add('ring-2', 'ring-[#167D8D]');
        penBtn?.click();
      });
    });

    document.getElementById('draw-size-slider')?.addEventListener('input', (e) => {
      drawSize = Number(e.target.value) || 4;
    });

    document.getElementById('draw-btn-undo')?.addEventListener('click', () => {
      if (!canvas || !ctx || undoStack.length === 0) return;
      undoStack.pop();
      const prev = undoStack[undoStack.length - 1];
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      if (prev) {
        const img = new Image();
        img.onload = () => {
          ctx.drawImage(img, 0, 0);
          localStorage.setItem(STORAGE_KEY_CANVAS, prev);
        };
        img.src = prev;
      } else {
        localStorage.removeItem(STORAGE_KEY_CANVAS);
      }
    });

    document.getElementById('draw-btn-clear')?.addEventListener('click', () => {
      if (!canvas || !ctx) return;
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      localStorage.removeItem(STORAGE_KEY_CANVAS);
      undoStack.length = 0;
    });

    document.getElementById('draw-btn-download')?.addEventListener('click', () => {
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = (getActiveTab()?.title || 'purenote-sketch') + '.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });

    // 1-Click Exports (.TXT, .HTML, .MD, and Print-Ready Notepad to PDF)
    function downloadBlob(filename, content, mimeType) {
      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function getSafeFilename(ext) {
      const raw = (getActiveTab()?.title || 'purenote').trim();
      const safe = raw.replace(/[^a-zA-Z0-9\u00C0-\u024F\u0400-\u04FF\u4E00-\u9FFF\u3040-\u30FF_-]+/g, '-').replace(/^-+|-+$/g, '') || 'purenote';
      return safe + '.' + ext;
    }

    // Export Format & Live Word Count Popover Toggle
    const exportToggleBtn = document.getElementById('btn-export-menu-toggle');
    const exportMenu = document.getElementById('export-format-menu');
    const exportWrapper = document.getElementById('export-dropdown-wrapper');
    const exportChevron = document.getElementById('export-menu-chevron');

    function setExportMenuOpen(open) {
      if (!exportMenu || !exportToggleBtn) return;
      if (open) {
        exportMenu.classList.remove('hidden');
        exportToggleBtn.setAttribute('aria-expanded', 'true');
        if (exportChevron) exportChevron.style.transform = 'rotate(180deg)';
      } else {
        exportMenu.classList.add('hidden');
        exportToggleBtn.setAttribute('aria-expanded', 'false');
        if (exportChevron) exportChevron.style.transform = 'rotate(0deg)';
      }
    }

    exportToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!exportMenu) return;
      setExportMenuOpen(exportMenu.classList.contains('hidden'));
    });

    document.addEventListener('click', (e) => {
      if (exportWrapper && !exportWrapper.contains(e.target)) {
        setExportMenuOpen(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setExportMenuOpen(false);
      }
    });

    document.getElementById('btn-export-txt')?.addEventListener('click', () => {
      const content = textarea ? textarea.value : '';
      downloadBlob(getSafeFilename('txt'), content, 'text/plain;charset=utf-8');
      setExportMenuOpen(false);
    });

    document.getElementById('btn-export-md')?.addEventListener('click', () => {
      const title = getActiveTab()?.title || 'Note';
      const body = textarea ? textarea.value : '';
      const md = `# ${title}\n\n${body}\n`;
      downloadBlob(getSafeFilename('md'), md, 'text/markdown;charset=utf-8');
      setExportMenuOpen(false);
    });

    document.getElementById('btn-export-html')?.addEventListener('click', () => {
      const title = (getActiveTab()?.title || 'PureNote Document').replace(/</g, '&lt;');
      const body = (textarea ? textarea.value : '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\r?\n/g, '<br>\n');
      const htmlDoc = `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>${title}</title>
<style>
  body { font-family: system-ui, -apple-system, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; line-height: 1.7; color: #071B2B; }
  h1 { border-bottom: 2px solid #167D8D; padding-bottom: 10px; }
</style>
</head>
<body>
  <h1>${title}</h1>
  <div>${body}</div>
</body>
</html>`;
      downloadBlob(getSafeFilename('html'), htmlDoc, 'text/html;charset=utf-8');
      setExportMenuOpen(false);
    });

    // Notepad to PDF Generator
    function generatePrintReadyPdf() {
      setExportMenuOpen(false);
      const current = getActiveTab();
      const docTitle = (pdfTitleInput && pdfTitleInput.value) || current?.title || 'PureNote Document';
      const fontSelect = document.getElementById('pdf-font-family');
      const fontChoice = fontSelect ? fontSelect.value : 'sans';
      const includeDate = document.getElementById('pdf-opt-date')?.checked ?? true;
      const includeMetrics = document.getElementById('pdf-opt-metrics')?.checked ?? true;
      const includeLines = document.getElementById('pdf-opt-lines')?.checked ?? false;
      const includeSketch = document.getElementById('pdf-opt-sketch')?.checked ?? false;

      const fontStack =
        fontChoice === 'serif'
          ? 'Georgia, Cambria, "Times New Roman", Times, serif'
          : fontChoice === 'mono'
            ? '"JetBrains Mono", Consolas, Monaco, monospace'
            : 'Inter, system-ui, -apple-system, sans-serif';

      const rawText = textarea ? textarea.value : '';
      const escapedLines = rawText
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .split(/\r?\n/);

      const formattedBody = includeLines
        ? escapedLines
            .map(
              (line, idx) =>
                `<div style="display:flex;gap:14px;"><span style="color:#167D8D;user-select:none;min-width:28px;text-align:right;font-family:monospace;">${idx + 1}.</span><span style="flex:1;white-space:pre-wrap;word-break:break-word;">${line || ' '}</span></div>`
            )
            .join('')
        : `<div style="white-space:pre-wrap;word-break:break-word;">${escapedLines.join('\n')}</div>`;

      const wordsCount = rawText.trim() ? rawText.trim().split(/\s+/).filter(Boolean).length : 0;
      const charsCount = rawText.length;
      const sketchData = includeSketch ? localStorage.getItem(STORAGE_KEY_CANVAS) : null;

      const printWin = window.open('', '_blank', 'width=900,height=750');
      if (!printWin) {
        window.print();
        return;
      }

      printWin.document.write(`<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>${docTitle.replace(/</g, '&lt;')}</title>
  <style>
    @page { margin: 20mm; }
    body {
      font-family: ${fontStack};
      color: #071B2B;
      line-height: 1.65;
      font-size: 13pt;
      margin: 0;
      padding: 0;
    }
    .header {
      border-bottom: 2px solid #167D8D;
      padding-bottom: 10px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .header h1 {
      margin: 0;
      font-size: 20pt;
      color: #071B2B;
    }
    .header .date {
      font-size: 10pt;
      color: #167D8D;
    }
    .footer {
      margin-top: 28px;
      border-top: 1px solid #B9E4E8;
      padding-top: 10px;
      font-size: 9.5pt;
      color: #167D8D;
      display: flex;
      justify-content: space-between;
    }
    .sketch-box {
      margin-top: 24px;
      border: 1px solid #167D8D;
      border-radius: 8px;
      padding: 12px;
      page-break-inside: avoid;
    }
    .sketch-box img {
      max-width: 100%;
      height: auto;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>${docTitle.replace(/</g, '&lt;')}</h1>
    ${includeDate ? `<span class="date">${new Date().toLocaleString()}</span>` : ''}
  </div>
  <main>${formattedBody}</main>
  ${sketchData ? `<div class="sketch-box"><img src="${sketchData}" alt="Sketch" /></div>` : ''}
  ${
    includeMetrics
      ? `<div class="footer"><span>Words: ${wordsCount} | Characters: ${charsCount} | Lines: ${escapedLines.length}</span><span>PureNote — purenote.github.io</span></div>`
      : ''
  }
  <script>
    window.onload = function() {
      setTimeout(function() {
        window.print();
      }, 200);
    };
  <\/script>
</body>
</html>`);
      printWin.document.close();
    }

    document.getElementById('btn-export-pdf')?.addEventListener('click', generatePrintReadyPdf);
    document.getElementById('btn-pdf-studio-generate')?.addEventListener('click', generatePrintReadyPdf);

    // Boot workspace
    loadFromStorage();
    applyFontSize();
    syncEditorWithActiveTab();
  })();
</script>
